{
  "name": "express-hreflang-sitemap",
  "version": "1.2.2",
  "description": "The simplest way to add a sitemap with hreflang to an express application.",
  "keywords": [
    "sitemap",
    "sitemap xml",
    "express",
    "expressjs",
    "middleware"
  ],
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneevil/express-hreflang-sitemap"
  },
  "license": "MIT",
  "engines": {
    "node": ">=8"
  },
  "scripts": {
    "test": "jest",
    "coveralls": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "xo index.js"
  },
  "devDependencies": {
    "coveralls-next": "^6.0.2",
    "express": "^4.22.3",
    "jest": "^30.5.2",
    "node-mocks-http": "^1.18.1",
    "xo": "^5.0.1"
  },
  "xo": {
    "space": 4,
    "rules": {
      "unicorn/prefer-module": "off"
    }
  },
  "resolutions": {
    "coveralls-next/js-yaml": "^4.3.2"
  }
}
